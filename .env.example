# Database
DATABASE_URL="postgresql://kyro:kyro_password@localhost:5432/kyro"

# Better Auth
BETTER_AUTH_SECRET="F67jeyMQIO1T9rZSJtC9UdNzf1zB5pVL"
BETTER_AUTH_URL="http://localhost:3000"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Object storage (RustFS, any S3-compatible server works). The old MINIO_* names
# are still read as a fallback. docker compose uses S3_ACCESS_KEY / S3_SECRET_KEY
# as the RustFS root credentials. Change both before exposing it to a network.
S3_ENDPOINT="localhost"
S3_PORT=9000
S3_ACCESS_KEY="kyro_admin"
S3_SECRET_KEY="kyro_password"
S3_USE_SSL=false
S3_BUCKET="kyro-deployments"

# Socket.io
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# GitHub App (For Repository Access)
GITHUB_APP_ID="your_app_id"
GITHUB_APP_PRIVATE_KEY="your_base64_encoded_private_key"
GITHUB_APP_WEBHOOK_SECRET="your_webhook_secret"
GITHUB_APP_INSTALLATION_URL="https://github.com/apps/kyro-app/installations/new"

ENCRYPTION_KEY="your_64_char_hex_encryption_key"

BASE_DOMAIN="localhost"

MAX_MEMORY=768m
MAX_MEMORY_SWAP=3g
MAX_CPU=1.0

BUILD_NODE_OPTIONS=--max-old-space-size=512

WORKER_CONCURRENCY=1

# Successful deployments kept per project (production and preview counted
# separately, the active one is always kept). Older ones lose their files.
KEEP_DEPLOYMENTS=5

RUNNER_MEMORY=384m
RUNNER_MEMORY_SWAP=768m
RUNNER_MAX_INSTANCES=3
RUNNER_IDLE_TIMEOUT_MS=900000
